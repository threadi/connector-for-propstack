parameters:
  level: 8
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # plugin constants which are only defined at runtime (e.g. during an import).
    - '#^Constant CFPROP_[A-Z_]+ not found\.$#'
    # WordPress and WP-CLI constants which are not known to the stubs.
    - '#^Constant (WP_PLUGIN_DIR|ARRAY_A|MB_IN_BYTES|[A-Z]+_IN_SECONDS|WP_CLI) not found\.$#'
    # class which is only available in newer WordPress versions (guarded by function_exists() checks in the code).
    - '#(unknown class|Class) WP_Icon_Collections_Registry( not found)?\.$#'
    # the progress bar of WP-CLI is cli\progress\Bar or WP_CLI\NoOp, which handles all calls via __call().
    - '#^Call to an undefined method cli\\progress\\Bar\|WP_CLI\\NoOp::(tick|finish)\(\)\.$#'
    - '#^Call to method (tick|finish)\(\) on an unknown class cli\\progress\\Bar\.$#'
  paths:
    - app
    - connector-for-propstack.php
    - uninstall.php
  excludePaths:
     - app/Dependencies/*
  scanFiles:
     - %rootDir%/../../php-stubs/wordpress-stubs/wordpress-stubs.php
     - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-stubs.php
     - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
     - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
     - %rootDir%/../../php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
  earlyTerminatingFunctionCalls:
     - wp_send_json
