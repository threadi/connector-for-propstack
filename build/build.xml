<?xml version="1.0" encoding="UTF-8"?>
<project name="connector-for-propstack" basedir="." default="help">

    <!-- Include the config file -->
    <loadproperties srcFile="build.properties" />

    <!-- Sets variables, which can later be used. -->
    <property name="src.dir" location="../" />
    <property name="build.dir" location="../releases" />
    <property name="log.dir" location="./" />

    <!-- check for necessary vars -->
    <fail unless="plugin.slug" />
    <fail unless="plugin.version" />
    <fail unless="composer.path" />
    <fail unless="npm.path" />
    <fail message="Do not run as root!">
        <condition>
            <equals arg1="root" arg2="${user.name}"/>
        </condition>
    </fail>

    <!--
        Run a step of bin/build-release.sh.

        The script is also used by the GitHub workflow .github/workflows/build-zip.yml,
        so both create identical release zips.
    -->
    <macrodef name="release-step">
        <attribute name="args" />
        <attribute name="log" />
        <sequential>
            <delete file="${log.dir}/release-@{log}.txt"/>
            <exec dir="${src.dir}" failonerror="true" executable="bash" output="${log.dir}/release-@{log}.txt">
                <env key="CFPROP_COMPOSER" value="${composer.path}"/>
                <env key="CFPROP_NPM" value="${npm.path}"/>
                <arg line="bin/build-release.sh @{args}"/>
            </exec>
        </sequential>
    </macrodef>

	<!-- install composer (with the dev packages) -->
	<target name="composer-install">
		<delete file="${log.dir}/composer-install.txt"/>
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/composer-install.txt">
			<arg line="install"/>
		</exec>
	</target>

	<!-- install composer and npm packages and build the Blocks -->
	<target name="npm-build">
		<release-step args="install" log="install" />
	</target>

	<!-- generate autoloader for dev -->
	<target name="autoloader-generation-dev">
		<delete file="${log.dir}/autoloader-generation-dev.txt"/>
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/autoloader-generation-dev.txt">
			<arg line="dump-autoload -oa"/>
		</exec>
	</target>

	<!-- fix WCS issues automatically (not part of the build, so the build does not change the code) -->
	<target name="fix-wcs" depends="composer-install">
		<exec dir="${src.dir}" failonerror="false" executable="vendor/bin/phpcbf">
			<arg line="."/>
		</exec>
	</target>

	<!-- check WCS compatibility -->
	<target name="check-wcs" depends="composer-install">
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpcs">
			<arg line="."/>
		</exec>
	</target>

	<!-- generate documentation -->
	<target name="generate-documentation" depends="composer-install">
		<exec dir="${src.dir}" failonerror="false" executable="vendor/bin/wp-documentor">
			<arg line="parse app --format=markdown --output=doc/hooks.md --prefix=cfprop_ --exclude=Support.php --exclude=Transients.php"/>
		</exec>
	</target>

	<!-- check PHPStan -->
	<target name="check-phpstan" depends="composer-install">
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpstan">
			<arg line="analyse"/>
		</exec>
	</target>

	<!-- PHP Unit Tests -->
	<target name="php-unit-tests" depends="composer-install">
		<delete file="${log.dir}/php-unit-tests-1.txt"/>
		<delete file="${log.dir}/php-unit-tests-2.txt"/>
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/php-unit-tests-1.txt">
			<arg line="test-install-during-build"/>
		</exec>
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/php-unit-tests-2.txt">
			<arg line="test"/>
		</exec>
	</target>

	<!-- prepare -->
	<target name="prepare" description="Prepare the project" depends="npm-build" />

    <!-- init project -->
    <target name="init" description="Initialize the project" depends="prepare,autoloader-generation-dev" />

    <!-- create the release zip only, without any checks (e.g. to compare it with the zip from GitHub) -->
    <target name="release-zip" description="Creates the release zip with the actual state of the project">
        <release-step args="nodev" log="nodev" />
        <release-step args="collect ${plugin.version}" log="collect" />
        <release-step args="zip ${build.dir}/${plugin.slug}_${plugin.version}.zip" log="zip" />

        <!-- restore the dev packages for further development -->
        <antcall target="composer-install" />
    </target>

    <!-- create release-zip -->
    <target name="build" description="Builds a new release" depends="prepare,generate-documentation,php-unit-tests,check-phpstan,check-wcs">
        <antcall target="release-zip" />
    </target>

	<!-- show help for ant commands -->
    <target name="help">
        <java classname="org.apache.tools.ant.Main">
            <arg value="-projecthelp" />
            <arg value="-buildfile" />
            <arg value="build.xml" />
        </java>
    </target>

</project>
